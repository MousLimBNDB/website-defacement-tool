# ============================================================
# Website Defacement Detection Tool - Configuration Template
# ============================================================

# PostgreSQL Database (provided by client / VM)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=website_defacement
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Fallback SQLite DB path (if PostgreSQL is not reachable)
SQLITE_DB_PATH=data/monitoring.db

# Ollama Multimodal Vision Endpoint (e.g. running on VM with Qwen3:4B / Qwen2.5-VL)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=60

# Detection & Image Comparator Thresholds
SIMILARITY_THRESHOLD=0.98
PIXEL_DIFF_THRESHOLD=15

# Incident Alerting Webhook (Discord, Slack, or n8n Webhook Trigger)
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Path to Target Websites JSON registry
TARGETS_FILE=targets.json
